@Fpfl.Api_HostAddress = http://localhost:5132

### All item types
GET {{Fpfl.Api_HostAddress}}/item-types
Accept: application/json

### One item type
GET {{Fpfl.Api_HostAddress}}/item-types/1
Accept: application/json

### Not found -> 404 ApiResponse with correlationId
GET {{Fpfl.Api_HostAddress}}/item-types/999
Accept: application/json

### Validation -> 400 ApiResponse
GET {{Fpfl.Api_HostAddress}}/item-types/0
Accept: application/json

### Health
GET {{Fpfl.Api_HostAddress}}/health
Accept: application/json

# ---------------------------------------------------------------------------
# Auth: run "Guest login" first, then copy accessToken / refreshToken below.
# ---------------------------------------------------------------------------
@accessToken = paste-access-token-here
@refreshToken = paste-refresh-token-here

### Guest login (no password sent)
POST {{Fpfl.Api_HostAddress}}/auth/guest
Accept: application/json

### Login
POST {{Fpfl.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "guest.user@gmail.com",
  "password": "wrong-password"
}

### Who am I (needs accessToken)
GET {{Fpfl.Api_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}

### Who am I without a token -> 401 ApiResponse
GET {{Fpfl.Api_HostAddress}}/auth/me

### Refresh (each refresh token works once)
POST {{Fpfl.Api_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Logout (revokes the refresh token)
POST {{Fpfl.Api_HostAddress}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Change password as guest -> 403 ApiResponse
POST {{Fpfl.Api_HostAddress}}/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "anything",
  "newPassword": "something-new"
}

# ---------------------------------------------------------------------------
# Time periods: reads are public; create / rename / delete need an ADMIN token.
# ---------------------------------------------------------------------------
@adminToken = paste-admin-access-token-here

### All time periods
GET {{Fpfl.Api_HostAddress}}/time-periods
Accept: application/json

### One time period
GET {{Fpfl.Api_HostAddress}}/time-periods/1
Accept: application/json

### Create (admin) -> 201 with Location
POST {{Fpfl.Api_HostAddress}}/time-periods
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "id": 99,
  "name": "Test Period"
}

### Rename (admin): omit "id" to keep it
PUT {{Fpfl.Api_HostAddress}}/time-periods/99
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Period Renamed"
}

### Change id 99 -> 97 and rename (admin)
PUT {{Fpfl.Api_HostAddress}}/time-periods/99
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "id": 97,
  "name": "Test Period Moved"
}

### Delete (admin)
DELETE {{Fpfl.Api_HostAddress}}/time-periods/97
Authorization: Bearer {{adminToken}}

### Create as guest -> 403 ApiResponse
POST {{Fpfl.Api_HostAddress}}/time-periods
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": 98,
  "name": "Nope"
}

# ---------------------------------------------------------------------------
# User roles (admin only). Change the user id / role ids to match your data.
# ---------------------------------------------------------------------------

### A user's roles
GET {{Fpfl.Api_HostAddress}}/users/2/roles
Authorization: Bearer {{adminToken}}

### Add role 2 to user 2
POST {{Fpfl.Api_HostAddress}}/users/2/roles/2
Authorization: Bearer {{adminToken}}

### Remove role 2 from user 2
DELETE {{Fpfl.Api_HostAddress}}/users/2/roles/2
Authorization: Bearer {{adminToken}}

### Replace user 2's roles
PUT {{Fpfl.Api_HostAddress}}/users/2/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roleIds": [2]
}

# ---------------------------------------------------------------------------
# Client logs (anonymous, rate-limited to 30/minute per IP)
# ---------------------------------------------------------------------------

### Error log from the UI
POST {{Fpfl.Api_HostAddress}}/client-logs
Content-Type: application/json

{
  "level": "error",
  "url": "/item-types",
  "status": 500,
  "message": "Failed to load item types",
  "correlationId": "ref-123",
  "details": { "component": "ItemTypes" }
}

# ---------------------------------------------------------------------------
# Item types CRUD (admin). Reads are above.
# ---------------------------------------------------------------------------

### Create item type (admin)
POST {{Fpfl.Api_HostAddress}}/item-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "id": 99,
  "name": "Test Type"
}

### Change id 99 -> 97 and rename (admin)
PUT {{Fpfl.Api_HostAddress}}/item-types/99
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "id": 97,
  "name": "Test Type Moved"
}

### Delete item type (admin)
DELETE {{Fpfl.Api_HostAddress}}/item-types/97
Authorization: Bearer {{adminToken}}

# ---------------------------------------------------------------------------
# Items (signed in). Use the userId from your login response; 1 = credits, 2 = debits.
# ---------------------------------------------------------------------------
@userId = paste-userId-guid-here

### My credits
GET {{Fpfl.Api_HostAddress}}/items/{{userId}}/1
Authorization: Bearer {{accessToken}}

### My debits
GET {{Fpfl.Api_HostAddress}}/items/{{userId}}/2
Authorization: Bearer {{accessToken}}

### Someone else's items -> 403 (unless admin)
GET {{Fpfl.Api_HostAddress}}/items/00000000-0000-0000-0000-000000000001/1
Authorization: Bearer {{accessToken}}

### One item (404 if it isn't yours)
GET {{Fpfl.Api_HostAddress}}/items/1
Authorization: Bearer {{accessToken}}

### Every item (admin)
GET {{Fpfl.Api_HostAddress}}/items
Authorization: Bearer {{adminToken}}

### Create a monthly credit (paid on the 15th)
POST {{Fpfl.Api_HostAddress}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Side Gig",
  "amount": 250,
  "fkItemType": 1,
  "fkPeriod": 6,
  "monthlyDom": 15,
  "dateRangeReq": false
}

### Update it: switch to every other Friday starting Nov 6 (other fields are cleared)
PUT {{Fpfl.Api_HostAddress}}/items/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Side Gig",
  "amount": 125,
  "fkItemType": 1,
  "fkPeriod": 4,
  "everyOtherWeekDow": 5,
  "beginDate": "2026-11-06",
  "dateRangeReq": false
}

### Validation error -> 400 with the broken rule
POST {{Fpfl.Api_HostAddress}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Bad",
  "amount": 10,
  "fkItemType": 1,
  "fkPeriod": 5,
  "biMonthlyDay1": 15,
  "biMonthlyDay2": 15
}

### Delete it
DELETE {{Fpfl.Api_HostAddress}}/items/1
Authorization: Bearer {{accessToken}}
